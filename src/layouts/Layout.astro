---
import "../styles/global.css";
import { counterpart, localeOf, localized, translator, type MessageKey } from "../i18n";
import { STACK_REPO } from "../lib/sources";

interface Props {
  title?: string;
  description?: string;
  section?: "spec" | "adr" | "problems" | "registry" | "conformance" | "start";
}

const { title, description, section } = Astro.props;
const locale = localeOf(Astro.url);
const t = translator(locale);
const pageTitle = title ? `${title} | OpenFSP` : "OpenFSP";
const nav: Array<{ key: MessageKey; href: string; id: Props["section"] }> = [
  { key: "nav.spec", href: "/spec/", id: "spec" },
  { key: "nav.adr", href: "/adr/", id: "adr" },
  { key: "nav.problems", href: "/problems/", id: "problems" },
  { key: "nav.registry", href: "/registry/", id: "registry" },
  { key: "nav.conformance", href: "/conformance/", id: "conformance" },
  { key: "nav.start", href: "/start/", id: "start" },
];
const other = locale === "fr" ? "en" : "fr";
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(counterpart(Astro.url), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t("site.description")} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={other} href={alternate} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5f2ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#08211e" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description ?? t("site.description")} />
    <meta property="og:image" content="https://cdn.openfsp.org/png/logo/openfsp-logo-1024.png" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      try {
        const stored = localStorage.getItem("theme");
        if (stored === "light" || stored === "dark") document.documentElement.dataset.theme = stored;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">
      {t("nav.skip")}
    </a>
    <header class="site-header">
      <div class="page bar">
        <a class="brand" href={localized(locale, "/")} aria-label="OpenFSP">
          <img class="logo light-only" src="/openfsp-logo.svg" alt="" width="128" height="23" />
          <img class="logo dark-only" src="/openfsp-logo-inverse.svg" alt="" width="128" height="23" />
        </a>
        <nav class="primary" aria-label={t("nav.primary")}>
          <ul>
            {nav.map((item) => (
              <li>
                <a href={localized(locale, item.href)} aria-current={section === item.id ? "page" : undefined}>
                  {t(item.key)}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="tools">
          <a class="tool locale" href={counterpart(Astro.url)} hreflang={other} lang={other} aria-label={t("locale.label")}>
            {t("locale.switch")}
          </a>
          <button class="tool icon" type="button" data-theme-toggle aria-label={t("theme.toggle")}>
            <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
              <path
                d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              ></path>
            </svg>
            <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M19.5 14.6A8 8 0 0 1 9.4 4.5a8 8 0 1 0 10.1 10.1Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
            </svg>
          </button>
          <a class="tool icon" href={STACK_REPO.replace("/stack", "")} aria-label="GitHub">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 1.8a10.2 10.2 0 0 0-3.2 19.9c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 3 .8.1-.7.4-1.1.6-1.4-2.3-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .9-.3 2.8 1a9.6 9.6 0 0 1 5.1 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.2 10.2 0 0 0 12 1.8Z"
              ></path>
            </svg>
          </a>
          <button class="tool icon menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label={t("nav.menu")}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav" aria-label={t("nav.primary")} hidden>
        <ul class="page">
          {nav.map((item) => (
            <li>
              <a href={localized(locale, item.href)} aria-current={section === item.id ? "page" : undefined}>
                {t(item.key)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="page foot">
        <img class="mark light-only" src="/openfsp-mark.svg" alt="" width="28" height="28" />
        <img class="mark dark-only" src="/openfsp-mark-inverse.svg" alt="" width="28" height="28" />
        <p>
          {t("footer.status")} 0.1.0. {t("footer.carrier")} <a href="https://github.com/openfspht/openfsp/blob/main/LICENSE">{t("footer.licence")}</a>.
        </p>
        <p class="foot-links">
          <a href="https://github.com/openfspht">GitHub</a>
          <a href="https://github.com/openfspht/openfsp.org">{t("footer.source")}</a>
        </p>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "light" : "dark";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch {}
      });
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const menu = document.getElementById("mobile-nav");
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!open));
        if (menu) menu.hidden = open;
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -48px;
    z-index: 20;
    padding: 8px 12px;
    background: var(--text);
    color: var(--bg);
    border-radius: var(--radius);
  }

  .skip:focus {
    top: 12px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    height: var(--header-height);
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .brand {
    display: flex;
    flex: none;
  }

  .logo {
    height: 23px;
    width: auto;
  }

  .dark-only {
    display: none;
  }

  :global(:root[data-theme="dark"]) .dark-only {
    display: block;
  }

  :global(:root[data-theme="dark"]) .light-only {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .dark-only {
      display: block;
    }

    :global(:root:not([data-theme="light"])) .light-only {
      display: none;
    }
  }

  .primary ul,
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary ul {
    display: flex;
    gap: 4px;
  }

  .primary a,
  .mobile-nav a {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--text-muted);
  }

  .primary a:hover,
  .mobile-nav a:hover {
    color: var(--text);
    background: var(--surface-sunken);
  }

  .primary a[aria-current="page"],
  .mobile-nav a[aria-current="page"] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--marker);
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 10px;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-muted);
    font: 500 0.875rem/1 var(--font-body);
    text-decoration: none;
    cursor: pointer;
  }

  .tool:hover {
    color: var(--text);
    background: var(--surface-sunken);
  }

  .tool.icon {
    padding: 0;
  }

  .moon {
    display: none;
  }

  :global(:root[data-theme="dark"]) .moon {
    display: block;
  }

  :global(:root[data-theme="dark"]) .sun {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .moon {
      display: block;
    }

    :global(:root:not([data-theme="light"])) .sun {
      display: none;
    }
  }

  .menu-toggle {
    display: none;
  }

  .mobile-nav {
    border-top: 1px solid var(--rule);
    padding: 8px 0 12px;
  }

  .mobile-nav a {
    padding: 12px 10px;
  }

  @media (max-width: 1060px) {
    .primary {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (min-width: 1061px) {
    .mobile-nav {
      display: none;
    }
  }

  .site-footer {
    margin-top: 96px;
    border-top: 1px solid var(--rule);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    padding-top: 28px;
    padding-bottom: 40px;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .foot-links {
    margin-left: auto;
    display: flex;
    gap: 20px;
  }

  .foot a {
    color: var(--text-muted);
  }
</style>

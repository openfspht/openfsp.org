---
import Layout from "../layouts/Layout.astro";
import { localeOf, localized, translator } from "../i18n";

const locale = localeOf(Astro.url);
const t = translator(locale);
---

<Layout title={t("notFound.title")}>
  <div class="page">
    <header class="page-head">
      <h1>{t("notFound.title")}</h1>
      <p class="lead">{t("notFound.body")}</p>
      <p class="home">
        <a class="button" href={localized(locale, "/")}>
          {t("notFound.home")}
        </a>
      </p>
    </header>
  </div>
</Layout>

<style>
  .home {
    margin-top: 24px;
  }
</style>

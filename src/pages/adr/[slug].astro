---
import Document from "../../views/Document.astro";
import { adrDocuments, type DocumentEntry } from "../../lib/sources";

export function getStaticPaths() {
  return adrDocuments.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: DocumentEntry };
---

<Document entry={entry} kind="adr" />

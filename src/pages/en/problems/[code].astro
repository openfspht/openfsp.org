---
import Problem from "../../../views/Problem.astro";
import { problems, type Problem as ProblemType } from "../../../lib/sources";

export function getStaticPaths() {
  return problems().map((problem) => ({ params: { code: problem.code }, props: { problem } }));
}

const { problem } = Astro.props as { problem: ProblemType };
---

<Problem problem={problem} />

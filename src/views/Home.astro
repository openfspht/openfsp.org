---
import Layout from "../layouts/Layout.astro";
import { localeOf, localized, translator } from "../i18n";
import { GOVERNANCE_URL, STACK_REPO, ruleCount, rulesIn, specDocuments, specGroups } from "../lib/sources";
import { highlight } from "../lib/markdown";

const locale = localeOf(Astro.url);
const t = translator(locale);
const rules = ruleCount();

const request = `POST /v1/payments HTTP/1.1
Authorization: Bearer ofsp_live_…
Idempotency-Key: 8b0c7a4e-2f1d-4b0e-9a57-1c3e5d7f9a21
Content-Type: application/json

{
  "reference": "INV-2026-00184",
  "amount": { "amount": 125000, "currency": "HTG" },
  "provider": "moncash",
  "return_url": "https://merchant.example/checkout/184/return"
}`;

const response = `HTTP/1.1 201 Created
Content-Type: application/json

{
  "id": "pay_01J9ZK3QF8XN2M7VYB4C6D8E0G",
  "reference": "INV-2026-00184",
  "status": "pending",
  "amount": { "amount": 125000, "currency": "HTG" },
  "provider": "moncash",
  "next_action": {
    "type": "redirect",
    "redirect_url": "https://provider.example/checkout/abc123"
  }
}`;

const requestHtml = await highlight(request, "http");
const responseHtml = await highlight(response, "http");

const annotations = [
  { label: "Idempotency-Key", rule: "idempotence 1.3", href: "/spec/idempotence/#1.3" },
  { label: "amount", rule: "modèle de données 3.2", href: "/spec/modele-de-donnees/#3.2" },
  { label: "provider", rule: "API 5.1.1", href: "/spec/api-paiements/#5.1.1" },
  { label: "pending", rule: "cycle de vie 1.1", href: "/spec/cycle-de-vie/#1.1" },
  { label: "next_action", rule: "API 4", href: "/spec/api-paiements/#4" },
];

const normative = specGroups.filter((group) => group.label && group.label !== "Document informatif");
const scope = normative
  .flatMap((group) => group.documents)
  .map((entry) => ({ entry, rules: rulesIn(entry) }))
  .filter(({ rules }) => rules > 0);

const components = [
  { name: "home.components.spec", role: "home.components.spec.role", href: localized(locale, "/spec/"), where: "openfspht/adrs" },
  { name: "home.components.gateway", role: "home.components.gateway.role", href: `${STACK_REPO}/tree/main/backend/gateway`, where: "stack/backend/gateway" },
  {
    name: "home.components.simulator",
    role: "home.components.simulator.role",
    href: `${STACK_REPO}/tree/main/backend/simulator`,
    where: "stack/backend/simulator",
  },
  {
    name: "home.components.client",
    role: "home.components.client.role",
    href: `${STACK_REPO}/tree/main/frontend/packages/client`,
    where: "stack/frontend/packages/client",
  },
  { name: "home.components.validator", role: "home.components.validator.role", href: localized(locale, "/conformance/"), where: "stack/backend/validator" },
] as const;
const conventions = specDocuments.find((entry) => entry.slug === "conventions");
---

<Layout>
  <section class="hero page">
    <div class="pitch">
      <h1>{t("home.headline")}</h1>
      <p class="lead">{t("home.lead")}</p>
      <div class="actions">
        <a class="button primary" href={localized(locale, conventions ? `/spec/${conventions.slug}/` : "/spec/")}>
          {t("home.cta.spec")}
        </a>
        <a class="button" href={localized(locale, "/start/")}>
          {t("home.cta.start")}
        </a>
      </div>
      <p class="status">
        <span>{t("home.status.draft")} 0.1.0</span>
        <a href={localized(locale, "/spec/")}>
          {rules} {t("home.status.rules")}
        </a>
        <a href={localized(locale, "/spec/matrice-de-conformite/")}>{t("home.status.core")}</a>
      </p>
    </div>
    <figure class="exchange" aria-label={t("home.exchange.label")}>
      <figcaption>{t("home.exchange.label")}</figcaption>
      <div class="pane">
        <p class="pane-label">{t("home.exchange.request")}</p>
        <Fragment set:html={requestHtml} />
      </div>
      <div class="pane">
        <p class="pane-label">{t("home.exchange.response")}</p>
        <Fragment set:html={responseHtml} />
      </div>
      {t("spec.frenchOnly") && <p class="keys-note">{t("spec.frenchOnly")}</p>}
      <ul class="keys" lang="fr">
        {annotations.map((item) => (
          <li>
            <code>{item.label}</code>
            <a href={localized(locale, item.href)}>{item.rule}</a>
          </li>
        ))}
      </ul>
    </figure>
  </section>

  <section class="idea page" aria-labelledby="idea-title">
    <div class="idea-text">
      <h2 id="idea-title">{t("home.idea.title")}</h2>
      <p>{t("home.idea.body")}</p>
    </div>
    <svg class="diagram-stacked" viewBox="0 0 340 330" role="img" aria-labelledby="idea-title">
      <text x="0" y="14">
        {t("home.idea.apps")}
      </text>
      {["PHP", "TypeScript", "Python", "Kotlin"].map((name, i) => (
        <g>
          <rect x={(i % 2) * 175} y={28 + Math.floor(i / 2) * 44} width="165" height="34" rx="6" />
          <text x={(i % 2) * 175 + 82} y={50 + Math.floor(i / 2) * 44} text-anchor="middle" class="label">
            {name}
          </text>
        </g>
      ))}
      <path d="M170 116 V 142" class="edge" />
      <rect x="0" y="142" width="340" height="62" rx="6" class="hub" />
      <text x="170" y="170" text-anchor="middle" class="hub-label">
        {t("home.idea.gateway")}
      </text>
      <text x="170" y="189" text-anchor="middle" class="hub-note">
        {t("home.idea.gatewayNote")}
      </text>
      <path d="M170 204 V 230" class="edge" />
      <text x="0" y="250">
        {t("home.idea.operators")}
      </text>
      {["MonCash", "NatCash", "…"].map((name, i) => (
        <g>
          <rect x={i * 117} y="262" width="106" height="34" rx="6" />
          <text x={i * 117 + 53} y="284" text-anchor="middle" class="label">
            {name}
          </text>
        </g>
      ))}
    </svg>
    <svg class="diagram" viewBox="0 0 600 260" role="img" aria-labelledby="idea-title">
      <text x="20" y="22">
        {t("home.idea.apps")}
      </text>
      {["PHP", "TypeScript", "Python", "Kotlin"].map((name, i) => (
        <g>
          <rect x="20" y={44 + i * 50} width="130" height="34" rx="6" />
          <text x="85" y={66 + i * 50} text-anchor="middle" class="label">
            {name}
          </text>
          <path d={`M150 ${61 + i * 50} C 185 ${61 + i * 50}, 180 130, 210 130`} class="edge" />
        </g>
      ))}
      <rect x="210" y="94" width="180" height="72" rx="6" class="hub" />
      <text x="300" y="126" text-anchor="middle" class="hub-label">
        {t("home.idea.gateway")}
      </text>
      <text x="300" y="146" text-anchor="middle" class="hub-note">
        {t("home.idea.gatewayNote")}
      </text>
      <text x="450" y="22">
        {t("home.idea.operators")}
      </text>
      {["MonCash", "NatCash", "…"].map((name, i) => (
        <g>
          <path d={`M390 130 C 420 130, 415 ${86 + i * 50}, 450 ${86 + i * 50}`} class="edge" />
          <rect x="450" y={69 + i * 50} width="130" height="34" rx="6" />
          <text x="515" y={91 + i * 50} text-anchor="middle" class="label">
            {name}
          </text>
        </g>
      ))}
    </svg>
  </section>

  <section class="scope page" aria-labelledby="scope-title">
    <h2 id="scope-title">{t("home.scope.title")}</h2>
    <div class="table-wrap">
      <table>
        <tbody>
          {scope.map(({ entry, rules }) => (
            <tr>
              <th scope="row">
                <a href={localized(locale, `/spec/${entry.slug}/`)}>{entry.label}</a>
              </th>
              <td class="group">{entry.group}</td>
              <td class="count">
                <span class="n">{rules}</span> {t("home.status.rules")}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      <a href={localized(locale, "/spec/")}>{t("home.scope.more")}</a>
    </p>
  </section>

  <section class="components page" aria-labelledby="components-title">
    <h2 id="components-title">{t("home.components.title")}</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">{t("home.components.name")}</th>
            <th scope="col">{t("home.components.role")}</th>
            <th scope="col">{t("home.components.where")}</th>
          </tr>
        </thead>
        <tbody>
          {components.map((item) => (
            <tr>
              <th scope="row">
                <a href={item.href}>{t(item.name)}</a>
              </th>
              <td>{t(item.role)}</td>
              <td>
                <code>{item.where}</code>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="governance page" aria-labelledby="governance-title">
    <h2 id="governance-title">{t("home.governance.title")}</h2>
    <p>{t("home.governance.body")}</p>
    <p>
      <a href={GOVERNANCE_URL}>{t("home.governance.link")}</a>
    </p>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 56px;
    align-items: start;
    padding-top: 72px;
    padding-bottom: 80px;
  }

  h1 {
    font-size: clamp(2rem, 1.3rem + 2vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin-bottom: 24px;
    max-width: 22ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 0;
    margin-top: 40px;
    font-size: 0.875rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .status a {
    color: var(--text-muted);
  }

  .status > * + *::before {
    content: "";
    display: inline-block;
    width: 1px;
    height: 0.9em;
    margin: 0 14px;
    vertical-align: -0.1em;
    background: var(--rule-strong);
  }

  .exchange {
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    min-width: 0;
  }

  figcaption {
    font: 600 0.8125rem/1 var(--font-body);
    padding: 14px 16px;
    border-bottom: 1px solid var(--rule);
  }

  .pane + .pane {
    border-top: 1px solid var(--rule);
  }

  .pane-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    padding: 12px 16px 0;
  }

  .pane :global(pre) {
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 8px 16px 14px;
    font-size: 0.75rem;
  }

  .keys {
    list-style: none;
    margin: 0;
    padding: 12px 16px 14px;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 6px;
    font-size: 0.8125rem;
  }

  .keys li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .keys a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  section {
    position: relative;
  }

  section + section::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    height: 1px;
    background: var(--rule);
  }

  section:not(.hero) {
    padding-top: 64px;
    padding-bottom: 64px;
  }

  h2 {
    font-size: 1.625rem;
    margin-bottom: 20px;
  }

  .idea {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 56px;
    align-items: center;
  }

  .idea-text p,
  .governance p:first-of-type {
    max-width: var(--measure);
    font-size: 1.0625rem;
  }

  .diagram,
  .diagram-stacked {
    width: 100%;
    height: auto;
    font-family: var(--font-body);
  }

  .diagram-stacked {
    display: none;
  }

  .keys-note {
    font-size: 0.75rem;
    color: var(--text-muted);
    padding: 12px 16px 0;
    border-top: 1px solid var(--rule);
  }

  .keys-note + .keys {
    border-top: 0;
  }

  .diagram text,
  .diagram-stacked text {
    fill: var(--text-muted);
    font-size: 13px;
  }

  .diagram rect,
  .diagram-stacked rect {
    fill: var(--surface);
    stroke: var(--rule-strong);
  }

  .diagram .label,
  .diagram-stacked .label {
    fill: var(--text);
    font-size: 13px;
  }

  .diagram .edge,
  .diagram-stacked .edge {
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 1.5;
  }

  .diagram .hub,
  .diagram-stacked .hub {
    fill: var(--text);
    stroke: var(--text);
  }

  .diagram .hub-label,
  .diagram-stacked .hub-label {
    fill: var(--bg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
  }

  .diagram .hub-note,
  .diagram-stacked .hub-note {
    fill: var(--bg);
    opacity: 0.8;
    font-size: 11px;
  }

  .scope table th {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    border-bottom-color: var(--rule);
    width: 40%;
  }

  .scope .group {
    color: var(--text-muted);
  }

  .scope .count {
    text-align: right;
    font-size: 0.875rem;
    color: var(--text-muted);
    padding-right: 0;
    white-space: nowrap;
  }

  .scope .n {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .scope > p {
    margin-top: 20px;
  }

  .components th[scope="row"] {
    font-size: 0.9375rem;
    color: var(--text);
    white-space: nowrap;
  }

  .governance p + p {
    margin-top: 16px;
  }

  @media (max-width: 640px) {
    .status {
      flex-direction: column;
      gap: 4px;
    }

    .status a {
      color: var(--text-muted);
    }

    .status > * + *::before {
      display: none;
    }

    .diagram,
    .scope .group {
      display: none;
    }

    .diagram-stacked {
      display: block;
    }

    .components thead {
      display: none;
    }

    .components table,
    .components tbody,
    .components tr,
    .components th,
    .components td {
      display: block;
      width: auto;
      white-space: normal;
    }

    .components tr {
      padding: 14px 0;
      border-bottom: 1px solid var(--rule);
    }

    .components th,
    .components td {
      border: 0;
      padding: 2px 0;
    }

    .components td code {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 960px) {
    .hero,
    .idea {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .hero {
      padding-top: 48px;
    }
  }
</style>

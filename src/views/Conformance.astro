---
import Layout from "../layouts/Layout.astro";
import { localeOf, localized, translator } from "../i18n";
import { highlight } from "../lib/markdown";

const locale = localeOf(Astro.url);
const t = translator(locale);
const local = await highlight(
  "make simulator\nmake gateway-conformance\nmake validate          # target: gateway\nmake validate-native   # target: native operator, against mock_openfsp",
  "bash",
);
const messages = {
  valid: t("conformance.verify.valid"),
  invalid: t("conformance.verify.invalid"),
  matches: t("conformance.verify.matches"),
  mismatch: t("conformance.verify.mismatch"),
  notChecked: t("conformance.verify.notChecked"),
  format: t("conformance.verify.error.format"),
  type: t("conformance.verify.error.type"),
  keys: t("conformance.verify.error.keys"),
  unknownKey: t("conformance.verify.error.unknownKey"),
  crypto: t("conformance.verify.error.crypto"),
  report: t("conformance.verify.error.report"),
};
---

<Layout title={t("conformance.title")} section="conformance">
  <div class="page">
    <header class="page-head">
      <h1>{t("conformance.title")}</h1>
      <p class="lead">{t("conformance.intro")}</p>
      <p class="refs" lang="fr">
        <a href={localized(locale, "/spec/conformite/")}>conformité</a>
        <a href={localized(locale, "/spec/matrice-de-conformite/")}>matrice de conformité</a>
      </p>
    </header>

    <div class="columns">
      <section aria-labelledby="run-title">
        <h2 id="run-title">{t("conformance.run.title")}</h2>
        <p>{t("conformance.run.public")}</p>
        <p>{t("conformance.run.local")}</p>
        <Fragment set:html={local} />
      </section>

      <section aria-labelledby="verify-title">
        <h2 id="verify-title">{t("conformance.verify.title")}</h2>
        <p>{t("conformance.verify.intro")}</p>
        <p class="planned">{t("conformance.verify.planned")}</p>
        <form class="verify" data-messages={JSON.stringify(messages)} novalidate>
          <label for="jws">{t("conformance.verify.jws")}</label>
          <textarea id="jws" name="jws" rows="5" spellcheck="false" autocomplete="off" required placeholder="eyJhbGciOiJFZERTQSIsImtpZCI6..."></textarea>
          <label for="validator">{t("conformance.verify.validator")}</label>
          <input id="validator" name="validator" type="url" value="http://localhost:8095" placeholder="https://validate.openfsp.org" required />
          <span class="label" id="report-label">
            {t("conformance.verify.report")}
          </span>
          <div class="file">
            <input id="report" class="visually-hidden" name="report" type="file" accept="application/json,.json" aria-labelledby="report-label" />
            <label class="button" for="report">
              {t("conformance.verify.choose")}
            </label>
            <span class="file-name" data-empty={t("conformance.verify.noFile")}>
              {t("conformance.verify.noFile")}
            </span>
          </div>
          <button class="button primary" type="submit">
            {t("conformance.verify.submit")}
          </button>
          <p class="error" role="alert" hidden></p>
        </form>
        <div class="result" aria-live="polite" hidden>
          <dl>
            <div>
              <dt>{t("conformance.verify.signature")}</dt>
              <dd data-field="signature"></dd>
            </div>
            <div>
              <dt>{t("conformance.verify.key")}</dt>
              <dd data-field="key"></dd>
            </div>
            <div>
              <dt>{t("conformance.verify.digest")}</dt>
              <dd data-field="digest"></dd>
            </div>
            <div>
              <dt>{t("conformance.verify.target")}</dt>
              <dd data-field="target"></dd>
            </div>
            <div>
              <dt>{t("conformance.verify.date")}</dt>
              <dd data-field="date"></dd>
            </div>
            <div>
              <dt>{t("conformance.verify.suite")}</dt>
              <dd data-field="suite"></dd>
            </div>
            <div>
              <dt>{t("conformance.verify.core")}</dt>
              <dd data-field="core"></dd>
            </div>
            <div>
              <dt>{t("conformance.verify.profiles")}</dt>
              <dd data-field="profiles"></dd>
            </div>
          </dl>
        </div>
        <p class="limit">{t("conformance.verify.limit")}</p>
      </section>
    </div>
  </div>
</Layout>

<script>
  import { verifyAttestation } from "../lib/attestation";

  const form = document.querySelector<HTMLFormElement>("form.verify")!;
  const messages = JSON.parse(form.dataset.messages ?? "{}") as Record<string, string>;
  const error = form.querySelector<HTMLElement>(".error")!;
  const result = document.querySelector<HTMLElement>(".result")!;
  const field = (name: string) => result.querySelector<HTMLElement>(`[data-field="${name}"]`)!;
  const verdict = (ok: boolean, text: string) => {
    const span = document.createElement("span");
    span.className = ok ? "pass" : "fail";
    span.textContent = text;
    return span;
  };

  const fileInput = form.querySelector<HTMLInputElement>("#report")!;
  const fileName = form.querySelector<HTMLElement>(".file-name")!;
  fileInput.addEventListener("change", () => {
    fileName.textContent = fileInput.files?.[0]?.name ?? fileName.dataset.empty ?? "";
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    error.hidden = true;
    result.hidden = true;
    const data = new FormData(form);
    const button = form.querySelector("button")!;
    button.disabled = true;
    try {
      const file = data.get("report");
      const report = file instanceof File && file.size > 0 ? await file.text() : undefined;
      const outcome = await verifyAttestation(String(data.get("jws") ?? ""), String(data.get("validator") ?? ""), report);
      if ("error" in outcome) {
        error.textContent = (messages[outcome.error] ?? outcome.error).replace("{kid}", "kid" in outcome ? outcome.kid : "");
        error.hidden = false;
        return;
      }
      field("signature").replaceChildren(verdict(outcome.signatureValid, outcome.signatureValid ? messages.valid : messages.invalid));
      field("key").textContent = `${outcome.kid}${outcome.keyStatus ? ` (${outcome.keyStatus})` : ""}`;
      field("digest").replaceChildren(
        outcome.digestMatches === undefined
          ? document.createTextNode(messages.notChecked)
          : verdict(outcome.digestMatches, outcome.digestMatches ? messages.matches : messages.mismatch),
      );
      const payload = outcome.payload;
      field("target").textContent = `${payload.target?.kind ?? ""} ${payload.target?.base_url ?? ""}`.trim();
      field("date").textContent = payload.run?.date ?? payload.issued_at ?? "";
      field("suite").textContent = [payload.suite?.version, payload.suite?.protocol_version].filter(Boolean).join(" / ");
      const core = payload.verdicts?.core;
      field("core").textContent = typeof core === "string" ? core : (core?.verdict ?? JSON.stringify(core ?? ""));
      field("profiles").textContent = (payload.verdicts?.profiles ?? [])
        .map((profile: { capability?: string; name?: string; verdict?: string }) => `${profile.capability ?? profile.name}: ${profile.verdict}`)
        .join(", ");
      result.hidden = false;
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .refs {
    display: flex;
    gap: 20px;
    margin-top: 16px;
    font-size: 0.9375rem;
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  h2 {
    font-size: 1.375rem;
    margin-bottom: 12px;
  }

  section > p {
    margin-bottom: 14px;
    max-width: var(--measure);
  }

  .verify {
    display: grid;
    gap: 8px;
    margin-top: 20px;
  }

  .verify > label,
  .verify > .label {
    font-size: 0.875rem;
    font-weight: 600;
    margin-top: 8px;
  }

  .planned {
    font-size: 0.875rem;
    color: var(--text-muted);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 10px 14px;
    background: var(--surface);
  }

  .file {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .file .button {
    min-height: 36px;
    font-size: 0.875rem;
  }

  .file input:focus-visible + .button {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .file-name {
    font-size: 0.875rem;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  textarea,
  input[type="url"] {
    width: 100%;
    font: 0.8125rem/1.5 var(--font-mono);
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 10px 12px;
  }

  textarea {
    resize: vertical;
    word-break: break-all;
  }

  textarea::placeholder {
    color: var(--text-muted);
  }

  .verify > .button {
    justify-self: start;
    margin-top: 12px;
  }

  .error {
    color: var(--fail);
    font-size: 0.9375rem;
    margin-top: 8px;
  }

  .result {
    margin-top: 28px;
    border-top: 1px solid var(--rule);
  }

  .result dl {
    margin: 0;
  }

  .result dl div {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
  }

  .result dt {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .result dd {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .result :global(.pass) {
    color: var(--pass);
    font-weight: 600;
  }

  .result :global(.fail) {
    color: var(--fail);
    font-weight: 600;
  }

  .limit {
    margin-top: 24px;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }

    .result dl div {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>

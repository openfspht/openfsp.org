---
import Layout from "../layouts/Layout.astro";
import { localeOf, localized, translator } from "../i18n";
import { adrDocuments, editUrl, renderDocument, sourcePath, sourceUrl, specGroups, type DocumentEntry } from "../lib/sources";

interface Props {
  entry: DocumentEntry;
  kind: "spec" | "adr";
}

const { entry, kind } = Astro.props;
const locale = localeOf(Astro.url);
const t = translator(locale);
const rendered = await renderDocument(entry, locale, kind === "spec" ? "spec" : "text");
const groups = kind === "spec" ? specGroups : [{ label: "", documents: adrDocuments }];
const base = kind === "spec" ? "/spec/" : "/adr/";
const hasMermaid = rendered.html.includes('class="mermaid"');
const frenchNotice = t("spec.frenchOnly");
---

<Layout title={rendered.title || entry.label} section={kind}>
  <div class="page doc">
    <nav class="sidebar" aria-label={t("spec.documents")}>
      <details open>
        <summary>{kind === "spec" ? t("spec.title") : t("adr.title")}</summary>
        {groups.map((group) => (
          <div class="group">
            {group.label && <p class="group-label">{group.label}</p>}
            <ul>
              {group.documents.map((item) => (
                <li>
                  <a href={localized(locale, `${base}${item.slug}/`)} aria-current={item.slug === entry.slug ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </details>
    </nav>

    <article class="prose" lang="fr" data-copy-label={t("spec.copyLink")} data-copied-label={t("spec.copied")}>
      <h1>{rendered.title || entry.label}</h1>
      <p class="meta" lang={locale}>
        <span>{t("home.status.draft")} 0.1.0</span>
        <span>
          <code>{sourcePath(entry)}</code>
        </span>
        <a href={sourceUrl(entry)}>{t("spec.source")}</a>
      </p>
      {frenchNotice && (
        <p class="notice" lang={locale}>
          {frenchNotice}
        </p>
      )}
      <Fragment set:html={rendered.html} />
      <p class="edit" lang={locale}>
        <a href={editUrl(entry)}>{t("spec.edit")}</a>
      </p>
    </article>

    {rendered.headings.length > 1 && (
      <nav class="toc" aria-label={t("spec.onThisPage")}>
        <p class="toc-label">{t("spec.onThisPage")}</p>
        <ul lang="fr">
          {rendered.headings.map((heading) => (
            <li class={`depth-${heading.depth}`}>
              <a href={`#${heading.id}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</Layout>

{hasMermaid && <script>
  const blocks = document.querySelectorAll<HTMLElement>("pre.mermaid");
  if (blocks.length) {
    const { default: mermaid } = await import("mermaid");
    const dark = () =>
      document.documentElement.dataset.theme ? document.documentElement.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
    const sources = [...blocks].map((block) => block.textContent ?? "");
    const draw = async () => {
      mermaid.initialize({ startOnLoad: false, theme: dark() ? "dark" : "neutral", fontFamily: "ui-sans-serif, system-ui, sans-serif" });
      blocks.forEach((block, i) => {
        block.removeAttribute("data-processed");
        block.textContent = sources[i];
      });
      await mermaid.run({ nodes: [...blocks] });
    };
    await draw();
    new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  }
</script>}

<script>
  if (matchMedia("(max-width: 860px)").matches) document.querySelector(".sidebar details")?.removeAttribute("open");
  const article = document.querySelector<HTMLElement>(".prose");
  const label = article?.dataset.copyLabel ?? "";
  const copied = article?.dataset.copiedLabel ?? "";
  article?.querySelectorAll<HTMLElement>("p.rule").forEach((rule) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "rule-link";
    button.setAttribute("aria-label", `${label} ${rule.id}`);
    button.innerHTML =
      '<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';
    button.addEventListener("click", async () => {
      const url = `${location.origin}${location.pathname}#${rule.id}`;
      history.replaceState(null, "", `#${rule.id}`);
      try {
        await navigator.clipboard.writeText(url);
        button.dataset.state = "copied";
        button.setAttribute("aria-label", copied);
        setTimeout(() => {
          delete button.dataset.state;
          button.setAttribute("aria-label", `${label} ${rule.id}`);
        }, 1600);
      } catch {}
    });
    rule.prepend(button);
  });

  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>(".toc a")].map((link) => [decodeURIComponent(link.hash.slice(1)), link]));
  const headings = [...links.keys()].map((id) => document.getElementById(id)).filter((node): node is HTMLElement => node !== null);
  if (headings.length) {
    const update = () => {
      const offset = 120;
      let current = headings[0];
      for (const heading of headings) if (heading.getBoundingClientRect().top - offset <= 0) current = heading;
      links.forEach((link) => link.removeAttribute("aria-current"));
      links.get(current.id)?.setAttribute("aria-current", "true");
    };
    addEventListener("scroll", update, { passive: true });
    update();
  }
</script>

<style>
  .doc {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 220px;
    gap: 48px;
    align-items: start;
    padding-top: 40px;
  }

  .sidebar,
  .toc {
    position: sticky;
    top: calc(var(--header-height) + 24px);
    max-height: calc(100vh - var(--header-height) - 48px);
    overflow-y: auto;
    font-size: 0.875rem;
  }

  .sidebar summary {
    font: 700 0.9375rem/1.2 var(--font-display);
    list-style: none;
    margin-bottom: 16px;
    pointer-events: none;
  }

  .sidebar summary::-webkit-details-marker {
    display: none;
  }

  .group + .group {
    margin-top: 20px;
  }

  .group-label,
  .toc-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .sidebar ul,
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar a,
  .toc a {
    display: block;
    padding: 5px 10px;
    margin-left: -10px;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text-muted);
    line-height: 1.35;
  }

  .sidebar a:hover,
  .toc a:hover {
    color: var(--text);
    background: var(--surface-sunken);
  }

  .sidebar a[aria-current="page"] {
    color: var(--text);
    font-weight: 600;
    background: var(--surface-sunken);
  }

  .toc a {
    border-left: 2px solid transparent;
    border-radius: 0;
    margin-left: 0;
    padding-left: 12px;
  }

  .toc a[aria-current="true"] {
    color: var(--text);
    border-left-color: var(--marker);
  }

  .toc .depth-3 a {
    padding-left: 24px;
    font-size: 0.8125rem;
  }

  .prose {
    min-width: 0;
    max-width: var(--measure);
    padding-bottom: 24px;
  }

  .prose > h1 {
    font-size: clamp(1.875rem, 1.4rem + 1.6vw, 2.5rem);
    margin-bottom: 24px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: -12px 0 24px;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .meta a {
    color: var(--text-muted);
  }

  .prose .notice {
    margin-bottom: 28px;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    margin: 56px 0 16px;
    padding-top: 8px;
  }

  .prose :global(h3) {
    font-size: 1.1875rem;
    margin: 40px 0 12px;
  }

  .prose :global(h4) {
    font-size: 1rem;
    margin: 32px 0 10px;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(.table-wrap),
  .prose :global(pre),
  .prose :global(blockquote) {
    margin-bottom: 18px;
  }

  .prose :global(li + li) {
    margin-top: 6px;
  }

  .prose :global(blockquote) {
    margin-left: 0;
    padding-left: 16px;
    border-left: 1px solid var(--rule-strong);
    color: var(--text-muted);
  }

  .prose :global(p.rule) {
    position: relative;
    scroll-margin-top: calc(var(--header-height) + 24px);
  }

  .prose :global(p.rule:target) {
    background: color-mix(in oklab, var(--marker) 12%, transparent);
    box-shadow:
      -12px 0 0 color-mix(in oklab, var(--marker) 12%, transparent),
      12px 0 0 color-mix(in oklab, var(--marker) 12%, transparent);
    border-radius: 2px;
  }

  .prose :global(p.rule > strong:first-of-type) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    font-weight: 600;
  }

  .prose :global(.rule-link) {
    position: absolute;
    left: -34px;
    top: 2px;
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    opacity: 0;
    transition: opacity 120ms ease-out;
  }

  .prose :global(p.rule:hover .rule-link),
  .prose :global(.rule-link:focus-visible),
  .prose :global(.rule-link[data-state="copied"]) {
    opacity: 1;
  }

  .prose :global(.rule-link:hover) {
    color: var(--text);
    background: var(--surface-sunken);
  }

  .prose :global(.rule-link[data-state="copied"]) {
    color: var(--marker);
  }

  .prose :global(pre.mermaid) {
    background: var(--surface);
    text-align: center;
    font-family: var(--font-body);
  }

  .prose :global(.anchor-target) {
    position: relative;
    top: calc(-1 * var(--header-height) - 24px);
  }

  .edit {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
  }

  @media (max-width: 1180px) {
    .doc {
      grid-template-columns: 220px minmax(0, 1fr);
    }

    .toc {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .doc {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 24px;
    }

    .sidebar {
      position: static;
      max-height: none;
      border: 1px solid var(--rule);
      border-radius: var(--radius);
      padding: 12px 16px;
    }

    .sidebar summary {
      pointer-events: auto;
      cursor: pointer;
      margin-bottom: 0;
    }

    .sidebar details[open] summary {
      margin-bottom: 12px;
    }

    .prose :global(.rule-link) {
      display: none;
    }
  }
</style>

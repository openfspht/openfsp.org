---
import Layout from "../layouts/Layout.astro";
import { localeOf, translator, type MessageKey } from "../i18n";
import { REGISTRY_EDIT_URL, registry } from "../lib/sources";

const locale = localeOf(Astro.url);
const t = translator(locale);
const tables = await registry(locale);
const titles: MessageKey[] = ["registry.registered", "registry.reserved"];
---

<Layout title={t("registry.title")} section="registry">
  <div class="page">
    <header class="page-head">
      <h1>{t("registry.title")}</h1>
      <p class="lead">{t("registry.intro")}</p>
    </header>
    {tables.map((table, i) => (
      <section>
        <h2>{titles[i] ? t(titles[i]) : table.title}</h2>
        <div class="table-wrap">
          <table lang="fr">
            <thead>
              <tr>
                {table.header.map((cell) => (
                  <th scope="col">{cell}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {table.rows.map((row) => (
                <tr set:html={row} />
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}
    <p class="propose">
      <a class="button" href={REGISTRY_EDIT_URL}>
        {t("registry.propose")}
      </a>
    </p>
  </div>
</Layout>

<style>
  section {
    max-width: 960px;
  }

  section + section {
    margin-top: 48px;
  }

  h2 {
    font-size: 1.25rem;
    margin-bottom: 12px;
  }

  .propose {
    margin-top: 40px;
  }
</style>

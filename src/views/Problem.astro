---
import Layout from "../layouts/Layout.astro";
import { localeOf, localized, translator } from "../i18n";
import { problemCondition, type Problem } from "../lib/sources";
import { highlight } from "../lib/markdown";

interface Props {
  problem: Problem;
}

const { problem } = Astro.props;
const locale = localeOf(Astro.url);
const t = translator(locale);
const condition = await problemCondition(problem, locale);
const type = `https://openfsp.org/problems/${problem.code}`;
const example = JSON.stringify(
  {
    type,
    title: "…",
    status: problem.status,
    retryable: problem.retryable,
    effect: problem.effect,
    request_id: "req_01J9ZK3QF8XN2M7VYB4C6D8E0G",
  },
  null,
  2,
);
const exampleHtml = await highlight(example, "json");
---

<Layout title={problem.code} description={`${type}: ${problem.status}`} section="problems">
  <div class="page problem">
    <p class="back">
      <a href={localized(locale, "/problems/")}>{t("problems.back")}</a>
    </p>
    <h1>
      <code>{problem.code}</code>
    </h1>
    <p class="condition" lang="fr" set:html={condition} />
    <dl>
      <div>
        <dt>{t("problems.type")}</dt>
        <dd>
          <code>{type}</code>
        </dd>
      </div>
      <div>
        <dt>{t("problems.status")}</dt>
        <dd>
          <code>{problem.status}</code>
        </dd>
      </div>
      <div>
        <dt>retryable</dt>
        <dd>
          <code>{String(problem.retryable)}</code>
        </dd>
      </div>
      <div>
        <dt>effect</dt>
        <dd>
          <code>{problem.effect}</code>
        </dd>
      </div>
      <div>
        <dt>{t("problems.group")}</dt>
        <dd lang="fr">{problem.group}</dd>
      </div>
      <div>
        <dt>{t("problems.rule")}</dt>
        <dd>
          <a href={localized(locale, `/spec/api-paiements/#${problem.section}`)}>API {problem.section}</a>
        </dd>
      </div>
    </dl>
    <h2>{t("problems.example")}</h2>
    <Fragment set:html={exampleHtml} />
  </div>
</Layout>

<style>
  .problem {
    max-width: calc(760px + 2 * var(--gutter));
    padding-top: 48px;
  }

  .back {
    font-size: 0.875rem;
    margin-bottom: 24px;
  }

  h1 {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.375rem);
    margin-bottom: 16px;
    overflow-wrap: anywhere;
  }

  h1 code {
    background: transparent;
    padding: 0;
    font-size: inherit;
    font-weight: 600;
  }

  .condition {
    font-size: 1.125rem;
    margin-bottom: 32px;
  }

  dl {
    margin: 0 0 40px;
    border-top: 1px solid var(--rule);
  }

  dl div {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }

  dt {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  dd {
    margin: 0;
  }

  h2 {
    font-size: 1.125rem;
    margin-bottom: 12px;
  }

  @media (max-width: 560px) {
    dl div {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>

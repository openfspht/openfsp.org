---
import Layout from "../layouts/Layout.astro";
import { localeOf, translator, type MessageKey } from "../i18n";
import { highlight } from "../lib/markdown";
import { STACK_REPO } from "../lib/sources";

const locale = localeOf(Astro.url);
const t = translator(locale);
const steps: Array<{ title: MessageKey; body: MessageKey; code: string }> = [
  { title: "start.demo.title", body: "start.demo.body", code: `git clone ${STACK_REPO}.git\ncd stack\nmake demo` },
  {
    title: "start.dev.title",
    body: "start.dev.body",
    code: "make install\nmake dev   # gateway :8080, simulator :8090, console :5173, shop :5174, simulator UI :5175",
  },
  { title: "start.validate.title", body: "start.validate.body", code: "make simulator\nmake gateway-conformance\nmake validate\nmake validate-native" },
  { title: "start.sandbox.title", body: "start.sandbox.body", code: "make dev-sandbox" },
];
const rendered = await Promise.all(steps.map(async (step) => ({ ...step, html: await highlight(step.code, "bash") })));
---

<Layout title={t("start.title")} section="start">
  <div class="page">
    <header class="page-head">
      <h1>{t("start.title")}</h1>
      <p class="lead">{t("start.intro")}</p>
      <p class="repo">
        <a class="button" href={STACK_REPO}>
          {t("start.repo")}
        </a>
      </p>
    </header>
    <ol class="steps">
      {rendered.map((step) => (
        <li>
          <h2>{t(step.title)}</h2>
          <p>{t(step.body)}</p>
          <Fragment set:html={step.html} />
        </li>
      ))}
    </ol>
  </div>
</Layout>

<style>
  .repo {
    margin-top: 24px;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 820px;
    display: grid;
    gap: 40px;
  }

  h2 {
    font-size: 1.25rem;
    margin-bottom: 8px;
  }

  .steps p {
    color: var(--text-muted);
    margin-bottom: 14px;
    max-width: var(--measure);
  }
</style>

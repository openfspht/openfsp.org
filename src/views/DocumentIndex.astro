---
import Layout from "../layouts/Layout.astro";
import { localeOf, localized, translator } from "../i18n";
import { adrDocuments, rulesIn, specGroups } from "../lib/sources";

interface Props {
  kind: "spec" | "adr";
}

const { kind } = Astro.props;
const locale = localeOf(Astro.url);
const t = translator(locale);
const groups = kind === "spec" ? specGroups : [{ label: "", documents: adrDocuments }];
const base = kind === "spec" ? "/spec/" : "/adr/";
const rows = groups.map((group) => ({ label: group.label, documents: group.documents.map((entry) => ({ entry, rules: rulesIn(entry) })) }));
const title = kind === "spec" ? t("spec.title") : t("adr.title");
const notice = t("spec.frenchOnly");
---

<Layout title={title} section={kind}>
  <div class="page">
    <header class="page-head">
      <h1>{title}</h1>
      <p class="lead">{kind === "spec" ? t("spec.intro") : t("adr.intro")}</p>
      {notice && <p class="notice">{notice}</p>}
    </header>
    {rows.map((group) => (
      <section class="group">
        {group.label && <h2>{group.label}</h2>}
        <ul lang="fr">
          {group.documents.map(({ entry, rules }) => (
            <li>
              <a href={localized(locale, `${base}${entry.slug}/`)}>{entry.label}</a>
              {kind === "spec" && rules > 0 && (
                <span class="count" lang={locale}>
                  <span class="n">{rules}</span> {t("home.status.rules")}
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>

<style>
  .page-head .notice {
    margin-top: 20px;
    max-width: 62ch;
  }

  .group {
    max-width: 760px;
  }

  .group + .group {
    margin-top: 40px;
  }

  h2 {
    font-size: 1.125rem;
    margin-bottom: 8px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }

  li a {
    font-weight: 500;
    font-size: 1.0625rem;
  }

  .count {
    font-size: 0.8125rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .n {
    font-family: var(--font-mono);
  }
</style>
